# Copy to .env and fill in. Never commit .env.
# Image to run (compose.yaml). Pin a version tag (e.g. 1.0.0) in production instead of "latest".
VISITFLOW_IMAGE=ghcr.io/alperenncetinn/visitflow
VISITFLOW_VERSION=latest
VISITFLOW_DOMAIN=localhost
# Use long random values, e.g. openssl rand -base64 32
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=
# No admin credentials here: on first start open https://<domain>/Setup and enter the one-time
# setup code printed in the app log (docker compose logs app). The first account becomes admin.
# SMTP (defaults to the dev mail catcher: docker compose --profile dev up)
MAIL_TRANSPORT=Smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=None
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com
SECURITY_DESK_EMAIL=
TRAINING_DURATION_SECONDS=180
ORGANIZATION_NAME=VisitFlow
